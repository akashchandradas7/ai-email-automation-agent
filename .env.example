# ============================================================
# AI Email Automation Agent — Environment Configuration
# Copy this file to .env and insert your verified credentials:
#   cp .env.example .env
# ============================================================

# ----- Brevo (Sendinblue) Transactional API -----
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
SENDER_EMAIL=info@yourdomain.com
SENDER_NAME=GrowthFlow Team
REPLY_TO_EMAIL=hello@support.yourdomain.com

# ----- LLM Provider (DeepSeek / OpenAI / Nvidia NIM) -----
LLM_API_KEY=your-llm-api-key-here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=deepseek-ai/deepseek-v4-pro

# ----- Google Sheets CRM Integration -----
SHEET_LINK=https://docs.google.com/spreadsheets/d/your-google-sheet-id/edit
# Paste your raw Service Account JSON as a string or mount credentials.json
GOOGLE_CREDENTIALS_JSON=
CREDENTIALS_FILE=credentials.json

# ----- Application Settings -----
PORT=5000
LOG_LEVEL=INFO
